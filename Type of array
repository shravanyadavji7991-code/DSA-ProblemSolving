class Solution {
  public:
    int typeOfArr(vector<int>& arr) {
        // code here.
        int n = arr.size();
        int ca =0;
        int cd =0;
        
        for(int i = 1 ; i < n ; i++){
            if(arr[i]>arr[i-1])
                 ca++;
            else 
               cd++;
        }
        
        if(ca==n-1)
            return 1;
         
        else if(cd==n-1)
            return 2;
          
        else if(cd>ca)
            return 3;
          
        else
          return 4;
        
        
        
    }
};
