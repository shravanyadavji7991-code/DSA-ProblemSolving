class Solution {
  public:
    bool isSorted(vector<int>& arr) {
        // code here
        int n = arr.size();
        int i;
        
        for(i = 1 ; i < n  ; i++){
            if(arr[i]>=arr[i-1])
               continue;
            else{
              return false;
              break;
            } 
            
        }
        if(i==n)
        return true;
    }
};
