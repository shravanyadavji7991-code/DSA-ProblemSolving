class Solution {
  public:
    vector<int> findNumbers(int n, int d) {
        // code here
        vector<int> ans;
        
        if(d==0)
         ans.push_back(0);
        for(int i=d ; i<=n ; i++){
            int m=i;
            while(m){
                int t = m%10;
                if(d==t){
                 ans.push_back(i);
                 break;
                }
                 m = m/10;
            
            }
        }
        return ans;
    }
};
