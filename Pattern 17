class Solution {
public:
    void pattern17(int n) {
       for(int i = 1 ; i<=n ; i++){
           char p ='A';
         for(int k = n-i ; k>=1 ; k--)
              cout<<" ";

          for(int j = 1 ; j<=i ; j++){
             cout<<p;
             p++;
          } 
          p=p-2; 
         for(int j = 1 ; j<=i-1 ; j++){
                cout<<p;
                p--;
            }  
            cout<<"\n"; 
       }
    }
};
