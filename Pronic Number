class Solution {
  public:
    vector<int> pronicNumbers(int n) {
        // code here
        vector<int>ans;
        int i =0;
        int j = 1;
        while(1){
            int d = i*j;

            if(d<=n)
            ans.push_back(d);
            else
              break;
              
            if(d==n)
             break;
             
            i++;
            j++;
        } 
        return ans;
    }
};
