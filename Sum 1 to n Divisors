class Solution {
  public:
    long long sumOfDivisors(long long n) {
        // Code here
        int ans =0;
        for(int i = 1 ; i<=n ; i++){
            int d=0;
            for(int j = 1 ; j<=i ; j++){
                if(i%j==0)
                 d = d+j;
            }
            
            ans = ans +d;
      
        }
        return ans; 
    }
};
