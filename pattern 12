class Solution {
public:
    void pattern12(int n) {
       int m =n;
       for(int i = 1 ; i<=n ; i++){

         for(int j =1 ; j<=i ; j++)
           cout<<j;
         for(int k = 1 ; k<= 2*m -2 ; k++)
            cout<<" ";
            m--;
         for(int j = i ; j>=1 ; j--)
             cout<<j;
            cout<<"\n";   
       }
    }
};
