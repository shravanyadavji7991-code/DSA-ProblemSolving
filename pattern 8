class Solution {
    public void pattern8(int n) {
       for(int i = n ; i>=1 ; i--){
         for(int m = i+2 ; m<=n+1 ; m++){
            System.out.print(" ");
         }
         
         for (int j = 1 ; j<=i ; j++){
            System.out.print("*");
         }
         for(int k = 1  ; k<=i-1; k++){
            System.out.print("*");
         }
          System.out.println();
       }
    }
}
