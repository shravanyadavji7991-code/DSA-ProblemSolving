class Solution {
    public void pattern9(int n) {
        for(int i = 1 ; i <=n ; i++){
         for (int j = n-i ; j>=1 ; j--){
             System.out.print(" ");
          }
         for(int k= 1 ; k<=i-1 ; k++){
            System.out.print("*");
           }
         for(int m =1 ; m<=i ; m++){
            System.out.print("*");
         }
         System.out.println();
     }
     for(int i = n ; i>=1 ; i--){
         for(int m = 0 ; m<n-i ; m++){
            System.out.print(" ");
         }
         
         for (int j = 1 ; j<=i ; j++){
            System.out.print("*");
         }
         for(int k = 1  ; k<=i-1; k++){
            System.out.print("*");
         }
          System.out.println();
       }
    }
}
