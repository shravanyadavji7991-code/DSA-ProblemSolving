
class Solution {
public:
    vector<int> factorialNumbers(vector<int>& arr) {
        vector<int> ans;

        for (int x : arr) {
            long long fact = 1;

            for (int i = 1; i <= 12; i++) {
                fact *= i;

                if (fact == x) {
                    ans.push_back(x);
                    break;
                }

                if (fact > x) {
                    break;
                }
            }
        }

        return ans;
    }
};
