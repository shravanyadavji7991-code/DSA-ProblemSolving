
class Solution {
  public:
    vector<int> lcmAndGcd(int a, int b) {

        vector<int> ans;

        int x = a, y = b;
        int c = a;

        while(b!=0){
            int temp = b;
            b = c % b;
            c=temp;
        }

        int gcd = c;
        int lcm = (x * y) / gcd;

        ans.push_back(lcm);
        ans.push_back(gcd);

        return ans;
    }
};
