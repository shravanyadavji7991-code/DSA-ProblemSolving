class Solution {
  public:
    bool isPrime(int n) {
        // code here
        if(n==1)
         return false;
         if(n==2)
         return true;
         int i ;
         for( i = 2 ; i<=n/2 ; i++){
             if(n%i==0)
              return false;
         }
         if(i==n/2+1)
          return true;

    }

};
