class Solution {
public:
    int reverse(int x) {
        
       
        int m=0;
        while(x){
            int d = x%10;
            if( m > INT_MAX/10)
              return 0;
            if( m < INT_MIN/10)
              return 0;
            m = m*10 +d;
            x=x/10;
        }
        return m;
    }
};
